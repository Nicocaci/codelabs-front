{
	admin off
	auto_https off
}

:{$PORT:3000} {
	root * /app/dist
	encode gzip zstd

	# Assets con hash en el nombre: cache largo
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# {path}/index.html sirve /comercios → comercios/index.html
	# Sin fallback a /index.html: las rutas inexistentes dan 404 real (evita soft 404 en Google)
	try_files {path} {path}/index.html
	file_server

	handle_errors {
		respond "Página no encontrada" 404
	}
}
